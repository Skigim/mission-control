{
  "name": "personal-dashboard",
  "productName": "Mission Control",
  "description": "Utilitarian desktop hub for AI-native workflows and multi-project tracking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "dashboard": "./bin/dashboard.js",
    "dashboard-mcp": "./bin/mcp-server.js"
  },
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "desktop": "npm run build && node bin/launch-desktop.js",
    "desktop:dev": "concurrently -k -n \"vite,desktop\" -c \"green,cyan\" \"npm run client\" \"node bin/launch-desktop.js --dev\"",
    "client": "vite",
    "server": "node server/server.js",
    "mcp": "node bin/mcp-server.js",
    "cli": "node bin/dashboard.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:api": "node tests/api.test.js",
    "test:cli": "node tests/cli.test.js",
    "test": "node tests/storage.test.js && node tests/api.test.js && node tests/cli.test.js"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^17.0.0",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "electron": "^45.0.0",
    "express": "^4.21.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
