{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.skigim.missioncontrol",
  "productName": "Mission Control",
  "copyright": "Copyright © 2026 Skigim",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "server/**/*",
    "bin/**/*",
    "assets/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "assets/**/*",
    "bin/**/*",
    "server/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Mission Control",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
